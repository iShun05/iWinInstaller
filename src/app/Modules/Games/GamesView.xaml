<UserControl x:Class="IWinInstaller.App.Modules.Games.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <!-- Una tarjeta por juego -->
    <DataTemplate x:Key="GameCard">
      <Border x:Name="card" Style="{StaticResource Card}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding StateLabel}">
        <StackPanel>
          <!-- Cabecera: icono, nombre y estado -->
          <DockPanel LastChildFill="True">
            <Border x:Name="pill" DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource UnknownSoft}">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="dot" Style="{StaticResource StatusDot}" Margin="0,0,6,0"/>
                <TextBlock x:Name="state" Style="{StaticResource PillText}" Text="{Binding StateLabel}"/>
              </StackPanel>
            </Border>
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,2,12,0"/>
            </StackPanel>
          </DockPanel>
          <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Visibility="{Binding Busy, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite"/>

          <!-- Acciones -->
          <WrapPanel Margin="0,14,0,0" Visibility="{Binding IsInstalled, Converter={StaticResource Visible}}">
            <Button Style="{StaticResource Primary}" core:Ui.Icon="&#xE713;" Margin="0,0,8,8" Content="Optimizar" Command="{Binding OptimizeCommand}"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE73E;" Margin="0,0,8,8" Content="Comprobar archivos" Command="{Binding CheckCommand}"/>
            <Button Style="{StaticResource Ghost}" core:Ui.Icon="&#xE712;" core:Ui.OpensMenu="True" Margin="0,0,8,8" Content="Más">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Detalles" Icon="&#xE946;" Command="{Binding DetailsCommand}"/>
                  <MenuItem Header="Restaurar" Icon="&#xE777;" Command="{Binding RestoreCommand}" Visibility="{Binding HasBackup, Converter={StaticResource Visible}}"/>
                  <MenuItem Header="Abrir carpeta" Icon="&#xE838;" Command="{Binding OpenFolderCommand}"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </WrapPanel>
          <WrapPanel Margin="0,14,0,0" Visibility="{Binding IsMissing, Converter={StaticResource Visible}}">
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE8E5;" Margin="0,0,8,8" Content="Buscar el ejecutable…" Command="{Binding BrowseCommand}"/>
            <Button Style="{StaticResource Ghost}" core:Ui.Icon="&#xE71B;" Margin="0,0,8,8" Content="Web oficial" Command="{Binding WebsiteCommand}"/>
          </WrapPanel>

          <!-- Comprobar archivos -->
          <StackPanel Visibility="{Binding IsInstalled, Converter={StaticResource Visible}}">
            <WrapPanel>
              <CheckBox Content="Comprobación completa (MD5, lenta)" IsChecked="{Binding FullCheck}" Foreground="{StaticResource TextMuted}" Margin="0,0,16,6" VerticalAlignment="Center"
                        ToolTip="Además del tamaño, calcula el MD5 de cada archivo. Solo en juegos de HoYoverse."/>
              <Button Style="{StaticResource Ghost}" core:Ui.Icon="&#xE711;" Content="Cancelar" Command="{Binding CancelCheckCommand}" Margin="0,0,8,6" Visibility="{Binding IsChecking, Converter={StaticResource Visible}}"/>
              <Button Style="{StaticResource Ghost}" core:Ui.Icon="&#xE73E;" Content="Verificar en Steam" Command="{Binding SteamVerifyCommand}" Margin="0,0,8,6" Visibility="{Binding IsSteam, Converter={StaticResource Visible}}"/>
            </WrapPanel>
            <ProgressBar Maximum="1" Value="{Binding CheckProgress, Mode=OneWay}" Margin="0,0,0,8" Visibility="{Binding IsChecking, Converter={StaticResource Visible}}"/>
            <TextBlock Text="{Binding CheckMessage}" Foreground="{StaticResource Text}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding CheckMessage, Converter={x:Static core:TextToVisibility.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Problems}" Focusable="False" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" Foreground="{StaticResource Attention}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Detalles -->
          <Border Style="{StaticResource CardInset}" Margin="0,12,0,0" Visibility="{Binding ShowDetails, Converter={StaticResource Visible}}">
            <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- Optimizar -->
          <Border Style="{StaticResource CardInset}" Margin="0,12,0,0" Visibility="{Binding ShowOptimize, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Attention}" TextWrapping="Wrap" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ListRow}">
                      <DockPanel>
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Top" Margin="0,2,10,0"
                                  AutomationProperties.Name="{Binding Title}"/>
                        <StackPanel>
                          <WrapPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border x:Name="tag" Style="{StaticResource Pill}" Padding="8,1,9,2" Background="{StaticResource UnknownSoft}">
                              <TextBlock x:Name="tagText" Style="{StaticResource PillText}" Text="{Binding Label}" Foreground="{StaticResource TextMuted}"/>
                            </Border>
                          </WrapPanel>
                          <TextBlock Text="{Binding Change}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                          <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="320" Margin="0,8,0,0"
                                    Visibility="{Binding HasOptions, Converter={StaticResource Visible}}" AutomationProperties.Name="Límite de FPS"/>
                          <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsUnofficial}" Value="True">
                        <Setter TargetName="tag" Property="Background" Value="{StaticResource AttentionSoft}"/>
                        <Setter TargetName="tagText" Property="Foreground" Value="{StaticResource Attention}"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Hazlo tú en el juego" Style="{StaticResource Overline}" Margin="0,12,0,4"/>
              <ItemsControl ItemsSource="{Binding InGameTips}" Focusable="False">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource Muted}" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel Margin="0,14,0,0">
                <Button Style="{StaticResource Primary}" core:Ui.Icon="&#xE73E;" Content="Aplicar" Command="{Binding ApplyCommand}" Margin="0,0,12,0"/>
                <TextBlock Text="Antes se guarda una copia; «Restaurar» la devuelve." Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Result}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding Result, Converter={x:Static core:TextToVisibility.Instance}}"/>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Installed">
          <Setter TargetName="pill" Property="Background" Value="{StaticResource OkSoft}"/>
          <Setter TargetName="dot" Property="Fill" Value="{StaticResource Ok}"/>
          <Setter TargetName="state" Property="Foreground" Value="{StaticResource Ok}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Attention">
          <Setter TargetName="pill" Property="Background" Value="{StaticResource AttentionSoft}"/>
          <Setter TargetName="dot" Property="Fill" Value="{StaticResource Attention}"/>
          <Setter TargetName="state" Property="Foreground" Value="{StaticResource Attention}"/>
          <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AttentionBorder}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Running">
          <Setter TargetName="pill" Property="Background" Value="{StaticResource AccentSoft}"/>
          <Setter TargetName="dot" Property="Fill" Value="{StaticResource Accent}"/>
          <Setter TargetName="state" Property="Foreground" Value="{StaticResource Accent}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Left">
      <DockPanel LastChildFill="True" Margin="0,0,0,20">
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" core:Ui.Icon="&#xE72C;" Content="Buscar de nuevo" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Margin="16,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Juegos" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSubtitle}"
                     Text="Comprueba si tus juegos están instalados y sus archivos, y optimízalos para más FPS y menos input lag. Solo se tocan ajustes que guarda el propio juego o Windows, siempre con el juego cerrado y con copia para restaurar: nada de memoria, ejecutables ni archivos del juego."/>
        </StackPanel>
      </DockPanel>

      <!-- Pantalla -->
      <Border Style="{StaticResource Card}">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{Binding RaiseHzLabel}" Command="{Binding OpenSystemCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                  Visibility="{Binding CanRaiseHz, Converter={StaticResource Visible}}"/>
          <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Pantalla" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="{Binding Display}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource GameCard}" Focusable="False"/>

      <!-- Juegos de otros lanzadores: solo lista -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel LastChildFill="True" Margin="0,0,0,8">
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Otros juegos instalados" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding OtherGamesSummary}" Style="{StaticResource Muted}" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding OtherGames}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ListRow}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" core:Ui.Icon="&#xE838;" Content="Abrir carpeta" Command="{Binding OpenFolderCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Name, StringFormat=Abrir carpeta de {0}}"/>
                    <StackPanel>
                      <WrapPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Pill}" Padding="8,1,9,2" Background="{StaticResource UnknownSoft}">
                          <TextBlock Style="{StaticResource PillText}" Text="{Binding Launcher}" Foreground="{StaticResource TextMuted}"/>
                        </Border>
                      </WrapPanel>
                      <TextBlock Text="{Binding Info}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Folder}" Margin="0,3,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Caption}">
        <Run Text="Modo Juego y sin grabación en segundo plano están en"/>
        <Hyperlink Command="{Binding OpenLatencyCommand}">Latencia › Ajustes de juego</Hyperlink><Run Text=". La app no mide FPS: para comparar usa el contador del juego o CapFrameX."/>
      </TextBlock>
    </StackPanel>
  </ScrollViewer>
</UserControl>
