<UserControl x:Class="IWinInstaller.App.Modules.Rendimiento.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>

    <!-- Una acción de rendimiento: estado, texto de lo que hace y botones -->
    <DataTemplate x:Key="ActionRow">
      <Border x:Name="row" Style="{StaticResource ListRow}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding StateLabel}">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" MinWidth="120">
            <Border x:Name="pill" Style="{StaticResource Pill}" Background="{StaticResource UnknownSoft}" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="dot" Style="{StaticResource StatusDot}" Margin="0,0,6,0"/>
                <TextBlock x:Name="state" Style="{StaticResource PillText}" Text="{Binding StateLabel}"/>
              </StackPanel>
            </Border>
            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
              <Button Style="{StaticResource Primary}" core:Ui.Icon="&#xE73E;" Content="Aplicar" Margin="0,0,6,0"
                      Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                      Visibility="{Binding CanApply, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Title, StringFormat=Aplicar {0}}"/>
              <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE7A7;" Content="Deshacer"
                      Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                      Visibility="{Binding CanUndo, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Title, StringFormat=Deshacer {0}}"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Attention}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}"/>
            <TextBlock Text="{Binding Result}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasResult, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsApplied}" Value="True">
          <Setter TargetName="pill" Property="Background" Value="{StaticResource OkSoft}"/>
          <Setter TargetName="dot" Property="Fill" Value="{StaticResource Ok}"/>
          <Setter TargetName="state" Property="Foreground" Value="{StaticResource Ok}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Fila de la tabla antes/después -->
    <DataTemplate x:Key="CompareRow">
      <Border Style="{StaticResource ListRow}" Padding="0,9">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Metric}" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="1" Text="{Binding Before}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
          <TextBlock Grid.Column="2" Text="{Binding After}" Foreground="{StaticResource TextStrong}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          <TextBlock x:Name="verdict" Grid.Column="3" Text="{Binding VerdictText}" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Right"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Verdict}" Value="better"><Setter TargetName="verdict" Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
        <DataTrigger Binding="{Binding Verdict}" Value="worse"><Setter TargetName="verdict" Property="Foreground" Value="{StaticResource Attention}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TextLine">
      <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Left">
      <DockPanel LastChildFill="True" Margin="0,0,0,20">
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" core:Ui.Icon="&#xE72C;" Content="Actualizar" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Margin="16,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Rendimiento" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSubtitle}"
                     Text="Ajustes que se aplican desde aquí, sin abrir otras apps. Todos se pueden deshacer, y puedes medir el efecto antes y después. Nada corre en segundo plano salvo que actives el perfil de juego."/>
        </StackPanel>
      </DockPanel>

      <!-- Alerta térmica -->
      <Border Background="{StaticResource AttentionSoft}" BorderBrush="{StaticResource AttentionBorder}" BorderThickness="1" CornerRadius="8" Padding="12,9,14,9" Margin="0,0,0,12"
              Visibility="{Binding HasThermalAlert, Converter={StaticResource Visible}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource Attention}" VerticalAlignment="Top" Margin="0,2,10,0"/>
          <TextBlock Text="{Binding ThermalAlert}" Foreground="{StaticResource Attention}" TextWrapping="Wrap" FontWeight="SemiBold" LineHeight="19" AutomationProperties.LiveSetting="Assertive"/>
        </DockPanel>
      </Border>

      <!-- Acciones -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xEC4A;" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Acciones" Style="{StaticResource SectionTitle}"/>
              <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                         Text="Cada una guarda el valor anterior antes de cambiarlo y la comprobación posterior lo devuelve si Windows no lo acepta. No hace falta administrador."/>
            </StackPanel>
          </DockPanel>
          <CheckBox Content="Medir antes y después al aplicar o deshacer (≈ 35 s)" IsChecked="{Binding MeasureAround}" Margin="0,14,0,10"/>
          <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionRow}" Focusable="False"/>
        </StackPanel>
      </Border>

      <!-- Medición -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xEC4A;" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Medir antes y después" Style="{StaticResource SectionTitle}"/>
              <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                         Text="Mide en unos 14 s la sobrecarga de Sleep(1) (planificador y temporizador de Windows, la causa de muchos tirones) y el ping a Internet. Con PresentMon y un juego del perfil en marcha añade FPS y 1 % low. La primera medición queda como referencia; la siguiente se compara con ella."/>
            </StackPanel>
          </DockPanel>
          <WrapPanel Margin="0,14,0,0">
            <Button Style="{StaticResource Primary}" core:Ui.Icon="&#xEC4A;" Content="Medir ahora" Command="{Binding MeasureCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE711;" Content="Cancelar" Command="{Binding CancelMeasureCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
          <TextBlock Text="{Binding MeasureStatus}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>

          <!-- Tabla antes / después -->
          <StackPanel Visibility="{Binding HasCompare, Converter={StaticResource Visible}}" Margin="0,12,0,0">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
              <TextBlock Text="Métrica" Style="{StaticResource Overline}"/>
              <TextBlock Grid.Column="1" Text="Antes" Style="{StaticResource Overline}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="2" Text="Después" Style="{StaticResource Overline}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Text="Resultado" Style="{StaticResource Overline}" HorizontalAlignment="Right"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Compare}" ItemTemplate="{StaticResource CompareRow}" Focusable="False"/>
          </StackPanel>

          <TextBlock Text="{Binding FrameNote}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
          <Button Style="{StaticResource LinkButton}" Content="Buscar CapFrameX en Instalar" Command="{Binding InstallFrameToolCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
          <TextBlock Text="Últimas mediciones" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
          <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource TextLine}" Focusable="False"/>
        </StackPanel>
      </Border>

      <!-- Programas pesados -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel LastChildFill="True" Margin="0,0,0,8">
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE964;" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Programas que más memoria usan" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding HeavyNote}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Heavy}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ListRow}" Padding="0,8">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" core:Ui.Icon="&#xE711;" Content="Cerrar"
                            Command="{Binding DataContext.CloseAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat=Cerrar {0}}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Memory}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0"/>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Perfil de juego -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Perfil de juego" Style="{StaticResource SectionTitle}"/>
              <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                         Text="Al detectar uno de estos juegos en marcha: cierra con normalidad los navegadores y superposiciones elegidos, sube la prioridad del juego a «Alta» (nunca tiempo real) y activa Alto rendimiento. Al salir del juego lo restaura todo y reabre lo que cerró. Los navegadores reabren su última sesión solo si lo tienen configurado: guarda lo pendiente antes de jugar."/>
            </StackPanel>
          </DockPanel>
          <CheckBox Content="Vigilar mis juegos (mira cada 5 s mientras iWinInstaller está abierto)" IsChecked="{Binding MonitorEnabled}" FontWeight="SemiBold" Margin="0,14,0,0"/>
          <TextBlock Text="{Binding SessionText}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,6,0,8" AutomationProperties.LiveSetting="Polite"/>
          <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ListRow}" Padding="0,10">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource DangerGhost}" core:Ui.Icon="&#xE74D;" Content="Quitar" Visibility="{Binding IsCustom, Converter={StaticResource Visible}}"
                              Command="{Binding DataContext.RemoveCustomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel Margin="0,6,0,0">
                      <CheckBox Content="Prioridad alta" IsChecked="{Binding Priority}" Margin="0,0,16,4"/>
                      <CheckBox Content="Alto rendimiento" IsChecked="{Binding PowerPlan}" Margin="0,0,16,4"/>
                      <CheckBox Content="Cerrar superposiciones" IsChecked="{Binding CloseOverlays}" Margin="0,0,16,4"/>
                      <CheckBox Content="Cerrar navegador" IsChecked="{Binding CloseBrowsers}" Margin="0,0,16,4"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" core:Ui.Icon="&#xE710;" Content="Añadir juego" Command="{Binding AddCustomCommand}" Margin="8,0,0,0"/>
            <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Tag="Nombre del proceso, p. ej. juego.exe" AutomationProperties.Name="Proceso del juego a añadir">
              <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCustomCommand}"/></TextBox.InputBindings>
            </TextBox>
          </DockPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,8" Text="Para otro juego escribe el nombre de su proceso (como aparece en el Administrador de tareas), con o sin .exe."/>
          <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource TextLine}" Focusable="False"/>
        </StackPanel>
      </Border>

      <!-- Temperaturas -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" core:Ui.Icon="&#xE74D;" Content="Borrar historial" Command="{Binding ClearHistoryCommand}" VerticalAlignment="Top" Margin="12,0,0,0"/>
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE9CA;" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Temperaturas y throttling en partida" Style="{StaticResource SectionTitle}"/>
              <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                         Text="Con la vigilancia activa, durante cada partida se mira cada 5 s la temperatura (CPU por las zonas térmicas de Windows; NVIDIA con nvidia-smi si existe) y la frecuencia de la CPU. Si pasa de 90 °C (88 °C la gráfica) o se recorta la frecuencia con carga alta, sale un aviso y queda aquí el historial. Si tu equipo no expone sensores, instala HWiNFO desde Instalar."/>
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Thermal}" ItemTemplate="{StaticResource TextLine}" Focusable="False" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>

      <!-- Otras páginas -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Más mejoras en otras páginas" Style="{StaticResource SectionTitle}"/>
          <WrapPanel Margin="0,12,0,0">
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE701;" Content="Ping, bufferbloat y DNS" Command="{Binding OpenCommand}" CommandParameter="nav.gaming" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE74D;" Content="Liberar espacio y caché de shaders" Command="{Binding OpenCommand}" CommandParameter="nav.maintenance" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE7F4;" Content="Apps de inicio y salud" Command="{Binding OpenCommand}" CommandParameter="nav.equipo" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE7FC;" Content="Optimizar juegos (FPS)" Command="{Binding OpenCommand}" CommandParameter="nav.games" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE713;" Content="Hz de la pantalla y energía" Command="{Binding OpenCommand}" CommandParameter="nav.system" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
