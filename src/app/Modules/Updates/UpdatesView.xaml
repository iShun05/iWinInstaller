<UserControl x:Class="IWinInstaller.App.Modules.Updates.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" DataContext="{Binding Updates}">
    <StackPanel Margin="32,28,32,24" MaxWidth="920" HorizontalAlignment="Left">
      <DockPanel LastChildFill="False" Margin="0,0,0,6">
        <TextBlock Text="Actualizaciones" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Btn}" Content="Comprobar" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource Btn}" Content="Cancelar" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource Primary}" Content="Actualizar seleccionadas" Command="{Binding ApplyCommand}"/>
        </StackPanel>
      </DockPanel>
      <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite"/>

      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="6"
              Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
        <StackPanel>
          <DockPanel Margin="12,8,12,6" LastChildFill="False">
            <TextBlock Text="Marca las que quieras actualizar. «Mantener esta versión» la excluye también de «Actualizar todo» y de la actualización programada."
                       Foreground="{StaticResource TextMuted}" MaxWidth="620"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Marcar todas" Command="{Binding SelectAllCommand}"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,10">
                  <DockPanel LastChildFill="True">
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsEnabled="{Binding Excluded, Converter={x:Static local:InverseBoolean.Instance}}"
                              AutomationProperties.Name="{Binding Name, StringFormat=Actualizar {0}}"/>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                            Command="{Binding DataContext.ToggleExcludedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                          <Setter Property="Content" Value="Mantener esta versión"/>
                          <Style.Triggers><DataTrigger Binding="{Binding Excluded}" Value="True"><Setter Property="Content" Value="Volver a actualizar"/></DataTrigger></Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="12,0"
                               Visibility="{Binding HasStatus, Converter={StaticResource Visible}}"/>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextStrong}"/>
                      <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource TextMuted}"/>
                      <TextBlock Text="{Binding Note}" Foreground="{StaticResource Attention}" FontSize="12" Visibility="{Binding HasNote, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="Actualización programada" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
          <TextBlock Text="Opcional. Se ejecuta con tu usuario, omite las excluidas y las que necesitan asistente, no reinicia Windows y deja el informe para la próxima vez que abras la app."
                     Foreground="{StaticResource TextMuted}" Margin="0,4,0,12"/>
          <WrapPanel>
            <CheckBox Content="Activar" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,16,8"/>
            <ComboBox ItemsSource="{Binding Frequencies}" SelectedValue="{Binding ScheduleFrequency, Mode=TwoWay}" SelectedValuePath="Key" DisplayMemberPath="Value"
                      MinWidth="180" Margin="0,0,12,8" AutomationProperties.Name="Frecuencia"/>
            <TextBlock Text="a las" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox Text="{Binding ScheduleTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0,0,12,8" Background="#22222B" Foreground="{StaticResource Text}"
                     BorderBrush="{StaticResource Border}" Padding="6,4" AutomationProperties.Name="Hora (HH:mm)"/>
            <Button Style="{StaticResource Btn}" Content="Guardar" Command="{Binding SaveScheduleCommand}" Margin="0,0,0,8"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
