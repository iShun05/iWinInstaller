<UserControl x:Class="IWinInstaller.App.Modules.Updates.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core"
             xmlns:local="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" DataContext="{Binding Updates}">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Left">
      <DockPanel LastChildFill="True" Margin="0,0,0,6">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource Btn}" Content="Comprobar" core:Ui.Icon="&#xE72C;" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource Btn}" Content="Cancelar" core:Ui.Icon="&#xE711;" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,0,8,0"/>
          <Button Style="{StaticResource Primary}" Content="Actualizar seleccionadas" core:Ui.Icon="&#xE896;" Command="{Binding ApplyCommand}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Actualizaciones"/>
      </DockPanel>
      <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"
                 Text="Marca las que quieras actualizar. «Mantener esta versión» la excluye también de «Actualizar todo» y de la actualización programada."/>
      <ContentControl Style="{StaticResource InfoBar}" Content="{Binding Message}"/>

      <!-- Aplicaciones con actualización -->
      <Border Style="{StaticResource Card}" Padding="20,16,20,6" Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
        <StackPanel>
          <DockPanel Margin="0,0,0,12" LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Marcar todas" core:Ui.Icon="&#xE73E;" Command="{Binding SelectAllCommand}"/>
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CardTitle}" Text="Aplicaciones"/>
              <TextBlock Style="{StaticResource Muted}" Text="Elige cuáles actualizar ahora."/>
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ListRow}">
                  <DockPanel LastChildFill="True">
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsEnabled="{Binding Excluded, Converter={x:Static local:InverseBoolean.Instance}}"
                              AutomationProperties.Name="{Binding Name, StringFormat=Actualizar {0}}"/>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                            Command="{Binding DataContext.ToggleExcludedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                          <Setter Property="Content" Value="Mantener esta versión"/>
                          <Style.Triggers><DataTrigger Binding="{Binding Excluded}" Value="True"><Setter Property="Content" Value="Volver a actualizar"/></DataTrigger></Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="12,0"
                            Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
                      <TextBlock Style="{StaticResource PillText}" Text="{Binding Status}" Foreground="{StaticResource Accent}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}"/>
                      <TextBlock Style="{StaticResource Muted}" Text="{Binding VersionText}"/>
                      <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Attention}" Text="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Estado vacío -->
      <Border Padding="20,36">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers><DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE930;" FontSize="28" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center"/>
          <TextBlock Style="{StaticResource Muted}" Text="No hay actualizaciones de aplicaciones pendientes." Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Drivers y firmware -->
      <Border Style="{StaticResource Card}" Padding="20,16,20,14" DataContext="{Binding Drivers}">
        <StackPanel>
          <DockPanel LastChildFill="True" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource Btn}" Content="Cancelar" core:Ui.Icon="&#xE711;" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,0,8,0"/>
              <Button Style="{StaticResource Btn}" Content="Comprobar drivers" core:Ui.Icon="&#xE72C;" Command="{Binding CheckCommand}"/>
            </StackPanel>
            <Border Style="{StaticResource IconTile}" VerticalAlignment="Top" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CardTitle}" Text="Drivers y firmware"/>
              <TextBlock Style="{StaticResource Muted}" Text="{Binding Message}" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Visibility="{Binding HasRows, Converter={StaticResource Visible}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ListRow}">
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" VerticalAlignment="Center" Margin="12,0,0,0"
                            Content="{Binding LinkLabel}" core:Ui.Icon="&#xE8E5;" Visibility="{Binding HasLink, Converter={StaticResource Visible}}"
                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}"/>
                      <TextBlock Style="{StaticResource Muted}" Text="{Binding Installed}"/>
                      <TextBlock Text="{Binding Status}" Margin="0,2,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsUpdate}" Value="True"><Setter Property="Foreground" Value="{StaticResource Attention}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                              <DataTrigger Binding="{Binding IsUpToDate}" Value="True"><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                     Text="Solo avisa: no descarga ni instala nada. Fuentes: Windows Update para todos los dispositivos y NVIDIA para las gráficas GeForce (envía solo el modelo de la GPU y la versión de Windows). AMD, Intel, red y BIOS no publican una consulta fiable: se muestra la versión instalada y la web oficial para compararla."/>
        </StackPanel>
      </Border>

      <!-- Actualización programada -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,14" LastChildFill="True">
            <Border Style="{StaticResource IconTile}" VerticalAlignment="Top" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CardTitle}" Text="Actualización programada"/>
              <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                         Text="Opcional. Se ejecuta con tu usuario, omite las excluidas y las que necesitan asistente, no reinicia Windows y deja el informe para la próxima vez que abras la app."/>
            </StackPanel>
          </DockPanel>
          <WrapPanel>
            <CheckBox Content="Activar" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,16,8"/>
            <ComboBox ItemsSource="{Binding Frequencies}" SelectedValue="{Binding ScheduleFrequency, Mode=TwoWay}" SelectedValuePath="Key" DisplayMemberPath="Value"
                      MinWidth="180" Margin="0,0,12,8" AutomationProperties.Name="Frecuencia"/>
            <TextBlock Style="{StaticResource Muted}" Text="a las" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox Text="{Binding ScheduleTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0,0,12,8" AutomationProperties.Name="Hora (HH:mm)"/>
            <Button Style="{StaticResource Btn}" Content="Guardar" core:Ui.Icon="&#xE74E;" Command="{Binding SaveScheduleCommand}" Margin="0,0,0,8"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
