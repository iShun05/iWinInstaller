<UserControl x:Class="IWinInstaller.App.Modules.Equipo.EquipoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <!-- Una fila del panel de salud con la misma pastilla de estado que el Inicio -->
    <DataTemplate x:Key="HealthRow" DataType="{x:Type core:StatusCard}">
      <Border x:Name="row" Style="{StaticResource ListRow}"
              AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Summary}">
        <DockPanel LastChildFill="True">
          <Border x:Name="pill" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="dot" Style="{StaticResource StatusDot}" Width="6" Height="6" Margin="0,0,6,0"/>
              <TextBlock x:Name="state" Style="{StaticResource PillText}" Text="{Binding StateLabel}"/>
            </StackPanel>
          </Border>
          <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Abrir" VerticalAlignment="Top"
                  Command="{Binding DataContext.OpenActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}" Visibility="{Binding HasAction, Converter={StaticResource Visible}}"
                  AutomationProperties.Name="{Binding Title, StringFormat=Abrir {0}}"/>
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{Binding Summary}" Margin="0,2,0,0"/>
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Reason}" Margin="0,3,0,0"
                       Visibility="{Binding HasReason, Converter={StaticResource Visible}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Ok">
          <Setter TargetName="pill" Property="Background" Value="{StaticResource OkSoft}"/>
          <Setter TargetName="dot" Property="Fill" Value="{StaticResource Ok}"/>
          <Setter TargetName="state" Property="Foreground" Value="{StaticResource Ok}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Attention">
          <Setter TargetName="pill" Property="Background" Value="{StaticResource AttentionSoft}"/>
          <Setter TargetName="dot" Property="Fill" Value="{StaticResource Attention}"/>
          <Setter TargetName="state" Property="Foreground" Value="{StaticResource Attention}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Left">
      <DockPanel LastChildFill="True" Margin="0,0,0,20">
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Top" Content="Comprobar de nuevo"
                core:Ui.Icon="&#xE72C;" Command="{Binding RefreshCommand}"/>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Equipo"/>
          <TextBlock Style="{StaticResource PageSubtitle}"
                     Text="Lee el hardware y el estado de Windows al entrar o al pulsar Comprobar. No deja nada en marcha en segundo plano."/>
          <TextBlock Style="{StaticResource Caption}" Text="{Binding LastChecked}" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- Hardware -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel LastChildFill="True" Margin="0,0,0,12">
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource CardTitle}" Text="{Binding Tier}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Machine}" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Style="{StaticResource CardInset}">
            <StackPanel>
              <TextBlock Text="{Binding Cpu}"/>
              <TextBlock Text="{Binding Ram}" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding Gpu}" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding Display}" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Preset -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel LastChildFill="True" Margin="0,0,0,12">
            <Border Style="{StaticResource IconTile}" VerticalAlignment="Top" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CardTitle}" Text="Preset: Dev + Gaming competitivo"/>
              <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                         Text="Un Windows ágil para programar y jugar en competitivo: base de desarrollo (Git, VS Code, terminal, modo desarrollador), baja latencia (Modo Juego, sin aceleración del ratón, sin grabación en segundo plano, DNS rápido) y lo que pide tu hardware."/>
            </StackPanel>
          </DockPanel>
          <TextBlock Text="{Binding PlanText}"/>
          <ItemsControl ItemsSource="{Binding Notes}" Margin="0,10,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6" Text="{Binding Text}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Primary}" Content="Marcar en Instalar" core:Ui.Icon="&#xE73E;" Command="{Binding ApplyPresetCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <!-- Salud -->
      <Border Style="{StaticResource Card}" Padding="20,18,20,8">
        <StackPanel>
          <DockPanel LastChildFill="True" Margin="0,0,0,12">
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource CardTitle}" Text="Salud" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource HealthRow}" Focusable="False"/>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Caption}"
                 Text="Las temperaturas salen de las zonas térmicas que Windows publica sin drivers extra; si tu equipo no las expone, usa HWiNFO o Core Temp desde Instalar."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
