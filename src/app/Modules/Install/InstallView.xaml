<UserControl x:Class="IWinInstaller.App.Modules.Install.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <Style x:Key="Field" TargetType="Control">
      <Setter Property="Background" Value="#22222B"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <DockPanel Margin="28,24,12,16">
      <!-- Cabecera y filtros -->
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="Instalar" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,12"/>
        <WrapPanel>
          <TextBox Style="{StaticResource Field}" Width="260" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                   AutomationProperties.Name="Buscar en el catálogo" ToolTip="Busca por nombre, uso o comparativa"/>
          <ComboBox Style="{StaticResource Field}" MinWidth="200" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" AutomationProperties.Name="Sección"/>
          <ComboBox Style="{StaticResource Field}" MinWidth="140" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" AutomationProperties.Name="Mostrar"/>
          <ComboBox Style="{StaticResource Field}" MinWidth="220" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" AutomationProperties.Name="Perfil"/>
          <Button Style="{StaticResource Ghost}" Content="Guardar perfil…" Command="{Binding SaveProfileCommand}" Margin="0,0,4,8"/>
          <Button Style="{StaticResource Ghost}" Content="Importar…" Command="{Binding ImportProfileCommand}" Margin="0,0,4,8"/>
          <Button Style="{StaticResource Ghost}" Content="Exportar…" Command="{Binding ExportProfileCommand}" Margin="0,0,4,8"/>
          <Button Style="{StaticResource Ghost}" Content="Desmarcar todo" Command="{Binding ClearCommand}" Margin="0,0,4,8"/>
          <Button Style="{StaticResource Ghost}" Content="Eliminar perfil" Command="{Binding DeleteProfileCommand}" Margin="0,0,4,8"/>
          <Button Style="{StaticResource Ghost}" Content="Verificar" Command="{Binding VerifyCommand}" Margin="0,0,4,8" ToolTip="Vuelve a comprobar qué está instalado"/>
        </WrapPanel>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>

      <!-- Barra de acciones -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
        <DockPanel LastChildFill="False">
          <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
          <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Margin="12,0,0,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Instalar" MinWidth="140" Command="{Binding InstallCommand}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Desinstalar marcadas" Foreground="#FFB0B0" Command="{Binding UninstallSelectedCommand}" Margin="0,0,8,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Pausar al terminar esta app" Command="{Binding PauseCommand}" Margin="0,0,8,0"
                  Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Reanudar lote" Command="{Binding ResumeCommand}" Margin="0,0,8,0"
                  Visibility="{Binding HasPending, Converter={StaticResource Visible}}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Informe de la última instalación" Command="{Binding ShowLastReportCommand}" Margin="0,0,8,0"/>
        </DockPanel>
      </Border>

      <!-- Catálogo agrupado y virtualizado -->
      <ListBox ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
               VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Catálogo">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <StackPanel Margin="6,16,10,6">
                  <TextBlock Text="{Binding Name}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
                  <Border x:Name="note" Background="#15202B" BorderBrush="#24384D" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Items[0].SubgroupNote}" Foreground="#C8D8EA" FontSize="12"/>
                  </Border>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Items[0].SubgroupNote}" Value=""><Setter TargetName="note" Property="Visibility" Value="Collapsed"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="card" Background="#19191C" CornerRadius="10" Padding="12,9" Margin="2,2" BorderThickness="1" BorderBrush="#29292E">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="#222227"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#8CC4FF"/></Trigger>
                    <DataTrigger Binding="{Binding IsChecked}" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#3D82C4"/></DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Name, StringFormat=Marcar {0}}"/>
              <Border Grid.Column="1" Width="36" Height="36" CornerRadius="9" Background="#182536" Margin="0,0,12,0" VerticalAlignment="Center">
                <Grid>
                  <TextBlock x:Name="ini" Text="{Binding Initials}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <TextBlock x:Name="gly" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                  <Border x:Name="pic" Width="28" Height="28" CornerRadius="7" Background="#F2F2F5" Visibility="Collapsed">
                    <Image Source="{Binding Image}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Border>
                </Grid>
              </Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                <DockPanel>
                  <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" Background="#1E2A33" VerticalAlignment="Center" Visibility="{Binding IsCli, Converter={StaticResource Visible}}">
                    <TextBlock Text="&gt;_ Terminal" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="#7FC8E8"/>
                  </Border>
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </DockPanel>
                <TextBlock Text="{Binding Desc}" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding Compare}" Foreground="#8FB3D9" FontSize="11.5" Margin="0,3,0,0" Visibility="{Binding HasCompare, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding Configuration}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,3,0,0" Visibility="{Binding HasConfiguration, Converter={StaticResource Visible}}"/>
              </StackPanel>
              <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="120">
                <Border x:Name="badge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Right" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
                  <TextBlock x:Name="badgeText" Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                </Border>
                <Button Style="{StaticResource Ghost}" Content="Pasos y notas" HorizontalAlignment="Right" Visibility="{Binding NeedsConfiguration, Converter={StaticResource Visible}}"
                        Command="{Binding DataContext.GuideCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                <Button Style="{StaticResource Ghost}" Content="{Binding OpenLabel}" HorizontalAlignment="Right" Visibility="{Binding ShowOpen, Converter={StaticResource Visible}}"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                <Button Style="{StaticResource Ghost}" Content="{Binding UninstallLabel}" Foreground="#FF9A9A" HorizontalAlignment="Right" Visibility="{Binding ShowUninstall, Converter={StaticResource Visible}}"
                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
              </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding HasGlyph}" Value="True"><Setter TargetName="gly" Property="Visibility" Value="Visible"/><Setter TargetName="ini" Property="Visibility" Value="Collapsed"/></DataTrigger>
              <DataTrigger Binding="{Binding HasImage}" Value="True"><Setter TargetName="pic" Property="Visibility" Value="Visible"/><Setter TargetName="ini" Property="Visibility" Value="Collapsed"/><Setter TargetName="gly" Property="Visibility" Value="Collapsed"/></DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="ok"><Setter TargetName="badge" Property="Background" Value="#1C3326"/><Setter TargetName="badgeText" Property="Foreground" Value="#78DC96"/></DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="bad"><Setter TargetName="badge" Property="Background" Value="#3A1E22"/><Setter TargetName="badgeText" Property="Foreground" Value="#FF7878"/></DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="busy"><Setter TargetName="badge" Property="Background" Value="#182536"/><Setter TargetName="badgeText" Property="Foreground" Value="#8CC4FF"/></DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Pasos y notas -->
    <Border Grid.Column="1" Width="380" Background="#141418" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0"
            Visibility="{Binding HasGuide, Converter={StaticResource Visible}}">
      <DockPanel Margin="20,24,20,16" DataContext="{Binding Guide}">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
          <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Cerrar" Command="{Binding DataContext.CloseGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" Margin="0,2,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock Text="Tus notas" Foreground="{StaticResource TextMuted}" FontSize="12"/>
          <TextBox Text="{Binding UserNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160" Margin="0,4,0,10"
                   Background="#22222B" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" Padding="8,6" AutomationProperties.Name="Tus notas"/>
          <WrapPanel>
            <Button Style="{StaticResource Btn}" Content="Comprobar" Margin="0,0,8,0" Command="{Binding DataContext.CheckGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Button Style="{StaticResource Ghost}" Content="{Binding LinkLabel}" Visibility="{Binding HasLink, Converter={StaticResource Visible}}"
                    Command="{Binding DataContext.OpenGuideLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          </WrapPanel>
          <TextBlock Text="{Binding Technical}" Foreground="{StaticResource Attention}" Margin="0,8,0,0"/>
          <TextBlock Text="Los pasos y la nota se guardan al cerrar. La comprobación técnica no confirma cuentas, licencias ni pruebas físicas: esas las marcas tú." Foreground="#77777F" FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Margin="0,4" Foreground="{StaticResource Text}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Note}" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Informe al terminar -->
    <Border Grid.ColumnSpan="2" Background="#E60B0B0F" Visibility="{Binding HasReport, Converter={StaticResource Visible}}">
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" MaxWidth="760" Margin="40" Padding="22,18" DataContext="{Binding Report}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Informe de la instalación" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
          </StackPanel>
          <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource Ghost}" Content="Copiar informe" Margin="0,0,8,0" Command="{Binding DataContext.CopyReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Button Style="{StaticResource Btn}" Content="Reintentar fallidas" Margin="0,0,8,0" Command="{Binding DataContext.RetryReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Button Style="{StaticResource Primary}" Content="Cerrar" IsCancel="True" Command="{Binding DataContext.CloseReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          </WrapPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,10">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · " Foreground="#77777F"/><Run Text="{Binding KindText, Mode=OneWay}" Foreground="{StaticResource Attention}"/></TextBlock>
                      <TextBlock Text="{Binding Reason}" Margin="0,3,0,0"/>
                      <TextBlock Text="{Binding Code}" Foreground="{StaticResource TextMuted}" FontSize="12" Visibility="{Binding HasCode, Converter={StaticResource Visible}}"/>
                      <TextBlock Text="{Binding Action}" Foreground="{StaticResource Accent}" Margin="0,3,0,0"/>
                      <TextBlock Text="{Binding Lines}" Foreground="#77777F" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,4,0,0" Visibility="{Binding HasLines, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
