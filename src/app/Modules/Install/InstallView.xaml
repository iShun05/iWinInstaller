<UserControl x:Class="IWinInstaller.App.Modules.Install.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <DockPanel Margin="40,32,28,0">
      <!-- Cabecera -->
      <StackPanel DockPanel.Dock="Top">
        <DockPanel LastChildFill="True" Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" core:Ui.Icon="&#xE72C;" Content="Verificar" VerticalAlignment="Top"
                  Command="{Binding VerifyCommand}" ToolTip="Vuelve a comprobar qué está instalado"/>
          <StackPanel Margin="0,0,16,0">
            <TextBlock Text="Instalar" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Marca lo que necesites del catálogo o elige un perfil, y pulsa Instalar. Lo ya instalado no se vuelve a marcar." Style="{StaticResource PageSubtitle}"/>
          </StackPanel>
        </DockPanel>

        <!-- Búsqueda y filtros -->
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Style="{StaticResource SearchBox}" Tag="Buscar por nombre, uso o comparativa" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                   AutomationProperties.Name="Buscar en el catálogo"/>
          <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="200" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" AutomationProperties.Name="Sección" ToolTip="Sección del catálogo"/>
          <ComboBox Grid.Column="2" Margin="8,0,0,0" Width="140" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" AutomationProperties.Name="Mostrar" ToolTip="Mostrar"/>
          <ComboBox Grid.Column="3" Margin="8,0,0,0" Width="210" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" AutomationProperties.Name="Perfil" ToolTip="Perfil: marca de golpe un conjunto de apps"/>
        </Grid>

        <!-- Barra de comandos: cada grupo de acciones en su menú -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="4" Margin="0,0,0,12">
          <DockPanel LastChildFill="False">
            <WrapPanel VerticalAlignment="Center">
              <Button Style="{StaticResource CommandButton}" core:Ui.Icon="&#xE77B;" Content="Perfiles" core:Ui.OpensMenu="True" AutomationProperties.Name="Perfiles">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Guardar lo marcado como perfil…" Icon="&#xE74E;" Command="{Binding SaveProfileCommand}"/>
                    <MenuItem Header="Importar perfil…" Icon="&#xE8B5;" Command="{Binding ImportProfileCommand}"/>
                    <MenuItem Header="Exportar perfil…" Icon="&#xEDE1;" Command="{Binding ExportProfileCommand}"/>
                    <Separator/>
                    <MenuItem Header="Eliminar perfil" Icon="&#xE74D;" Command="{Binding DeleteProfileCommand}"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Style="{StaticResource CommandButton}" core:Ui.Icon="&#xE7F4;" Content="Este PC" core:Ui.OpensMenu="True" AutomationProperties.Name="Este PC">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Style="{StaticResource MenuHeader}" Header="Configuración completa (apps, ajustes, pasos y exclusiones)"/>
                    <MenuItem Header="Importar desde otro PC…" Icon="&#xE8B5;" Command="{Binding ImportConfigCommand}"/>
                    <MenuItem Header="Exportar este PC como plantilla…" Icon="&#xEDE1;" Command="{Binding ExportConfigCommand}"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Style="{StaticResource CommandButton}" core:Ui.Icon="&#xE753;" Content="Sincronizar" core:Ui.OpensMenu="True" AutomationProperties.Name="Sincronizar con tu repo privado">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Style="{StaticResource MenuHeader}" Header="Tu repo privado de GitHub (sin notas personales)"/>
                    <MenuItem Header="Subir la configuración de este PC" Icon="&#xE898;" Command="{Binding SyncPushCommand}"/>
                    <MenuItem Header="Bajar y marcar sus apps" Icon="&#xE896;" Command="{Binding SyncPullCommand}"/>
                    <Separator/>
                    <MenuItem Header="Conectar o desconectar repo…" Icon="&#xE71B;" Command="{Binding SyncRepoCommand}"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Border Width="1" Height="20" Background="{StaticResource BorderStrong}" Margin="6,0" VerticalAlignment="Center"/>
              <ComboBox Width="168" Background="Transparent" BorderBrush="Transparent" ItemsSource="{Binding DevTemplates}" SelectedItem="{Binding DevTemplate}"
                        AutomationProperties.Name="Entorno de desarrollo" ToolTip="Plantilla del entorno de desarrollo"/>
              <Button Style="{StaticResource CommandButton}" core:Ui.Icon="&#xE943;" Content="Preparar entorno" Command="{Binding PrepareDevCommand}"
                      ToolTip="Instala lo que falte del entorno (Git, VS Code y Node, Python o Java con su versión fijada) y lo configura: Corepack, pip o JAVA_HOME"/>
            </WrapPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource CommandButton}" Foreground="{StaticResource TextMuted}" core:Ui.Icon="&#xE8E6;" Content="Desmarcar todo" Command="{Binding ClearCommand}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>

        <ContentControl Style="{StaticResource InfoBar}" Content="{Binding Message}"/>
      </StackPanel>

      <!-- Barra de acciones -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,14,0,16" Margin="0,4,0,0">
        <DockPanel LastChildFill="False">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="NoWrap"/>
            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Accent}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="NoWrap"
                       Visibility="{Binding ProgressText, Converter={x:Static core:TextToVisibility.Instance}}"/>
          </StackPanel>
          <!-- Leyenda de los puntos de estado -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
            <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Ok}" Margin="0,0,6,0"/><TextBlock Text="Instalada" Style="{StaticResource Caption}" Margin="0,0,14,0" TextWrapping="NoWrap"/>
            <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Attention}" Margin="0,0,6,0"/><TextBlock Text="Sin configurar" Style="{StaticResource Caption}" Margin="0,0,14,0" TextWrapping="NoWrap"/>
            <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Unknown}" Margin="0,0,6,0"/><TextBlock Text="No instalada" Style="{StaticResource Caption}" TextWrapping="NoWrap"/>
          </StackPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" core:Ui.Icon="&#xE896;" Content="Instalar" MinWidth="148" Command="{Binding InstallCommand}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource DangerBtn}" core:Ui.Icon="&#xE74D;" Content="Desinstalar marcadas" Command="{Binding UninstallSelectedCommand}" Margin="0,0,8,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" core:Ui.Icon="&#xE769;" Content="Pausar al terminar esta app" Command="{Binding PauseCommand}" Margin="0,0,8,0"
                  Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" core:Ui.Icon="&#xE768;" Content="Reanudar lote" Command="{Binding ResumeCommand}" Margin="0,0,8,0"
                  Visibility="{Binding HasPending, Converter={StaticResource Visible}}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" core:Ui.Icon="&#xE9F9;" Command="{Binding ShowLastReportCommand}" Margin="0,0,8,0"
                  ToolTip="Informe de la última instalación" AutomationProperties.Name="Informe de la última instalación"/>
        </DockPanel>
      </Border>

      <!-- Catálogo agrupado y virtualizado -->
      <Grid>
        <ListBox x:Name="Catalog" ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0,0,8,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Catálogo">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <StackPanel Margin="2,18,0,8">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Overline}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="note" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE82F;" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <TextBlock Text="{Binding Items[0].SubgroupNote}" Foreground="{StaticResource Text}" FontSize="12.5" LineHeight="18"/>
                      </DockPanel>
                    </Border>
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Items[0].SubgroupNote}" Value=""><Setter TargetName="note" Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="card" Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusCard}" Padding="14,12" Margin="0,0,0,6"
                            BorderThickness="1" BorderBrush="{StaticResource Border}" SnapsToDevicePixels="True">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="{StaticResource SurfaceHover}"/><Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BorderStrong}"/></Trigger>
                      <DataTrigger Binding="{Binding IsChecked}" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBorder}"/><Setter TargetName="card" Property="Background" Value="{StaticResource AccentSoft}"/></DataTrigger>
                      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,14,0" AutomationProperties.Name="{Binding Name, StringFormat=Marcar {0}}"/>
                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                  <Grid>
                    <TextBlock x:Name="ini" Text="{Binding Initials}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="gly" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    <Border x:Name="pic" Width="30" Height="30" CornerRadius="7" Background="#F2F2F5" Visibility="Collapsed">
                      <Image Source="{Binding Image}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                  <WrapPanel>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border x:Name="state" Style="{StaticResource Pill}" Padding="7,1,9,2" Margin="0,0,6,0" ToolTip="{Binding StateText}" AutomationProperties.Name="{Binding StateText}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="dot" Style="{StaticResource StatusDot}" Width="6" Height="6" Margin="0,0,6,0"/>
                        <TextBlock x:Name="stateText" Text="{Binding StateText}" Style="{StaticResource PillText}" FontSize="11"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" Padding="7,1,8,2" Background="{StaticResource SurfaceRaised}" Visibility="{Binding IsCli, Converter={StaticResource Visible}}">
                      <TextBlock Text="&gt;_ Terminal" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                    </Border>
                  </WrapPanel>
                  <TextBlock Text="{Binding Desc}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Compare}" Style="{StaticResource Caption}" Foreground="{StaticResource AccentMuted}" Margin="0,4,0,0" Visibility="{Binding HasCompare, Converter={StaticResource Visible}}"/>
                  <TextBlock Text="{Binding Configuration}" Style="{StaticResource Caption}" Foreground="{StaticResource Attention}" Margin="0,4,0,0" Visibility="{Binding HasConfiguration, Converter={StaticResource Visible}}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="120">
                  <Border x:Name="badge" Style="{StaticResource Pill}" HorizontalAlignment="Right" Margin="0,0,0,4" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
                    <TextBlock x:Name="badgeText" Text="{Binding Status}" Style="{StaticResource PillText}"/>
                  </Border>
                  <Button Style="{StaticResource Ghost}" core:Ui.Icon="&#xE8FD;" Content="Pasos y notas" HorizontalAlignment="Right" Visibility="{Binding NeedsConfiguration, Converter={StaticResource Visible}}"
                          Command="{Binding DataContext.GuideCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                  <Button Style="{StaticResource Ghost}" core:Ui.Icon="&#xE8A7;" Content="{Binding OpenLabel}" HorizontalAlignment="Right" Visibility="{Binding ShowOpen, Converter={StaticResource Visible}}"
                          Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                  <Button Style="{StaticResource DangerGhost}" core:Ui.Icon="&#xE74D;" Content="{Binding UninstallLabel}" HorizontalAlignment="Right" Visibility="{Binding ShowUninstall, Converter={StaticResource Visible}}"
                          Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasGlyph}" Value="True"><Setter TargetName="gly" Property="Visibility" Value="Visible"/><Setter TargetName="ini" Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding HasImage}" Value="True"><Setter TargetName="pic" Property="Visibility" Value="Visible"/><Setter TargetName="ini" Property="Visibility" Value="Collapsed"/><Setter TargetName="gly" Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="ok"><Setter TargetName="state" Property="Background" Value="{StaticResource OkSoft}"/><Setter TargetName="dot" Property="Fill" Value="{StaticResource Ok}"/><Setter TargetName="stateText" Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="pending"><Setter TargetName="state" Property="Background" Value="{StaticResource AttentionSoft}"/><Setter TargetName="dot" Property="Fill" Value="{StaticResource Attention}"/><Setter TargetName="stateText" Property="Foreground" Value="{StaticResource Attention}"/></DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="missing"><Setter TargetName="dot" Property="Fill" Value="{StaticResource TextFaint}"/><Setter TargetName="stateText" Property="Foreground" Value="{StaticResource TextMuted}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="ok"><Setter TargetName="badge" Property="Background" Value="{StaticResource OkSoft}"/><Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="bad"><Setter TargetName="badge" Property="Background" Value="{StaticResource DangerSoft}"/><Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="busy"><Setter TargetName="badge" Property="Background" Value="{StaticResource AccentSoft}"/><Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- Estado vacío -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems, ElementName=Catalog}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="32" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center"/>
          <TextBlock Text="Nada coincide con la búsqueda" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
          <TextBlock Text="Prueba otra palabra, «Todo el catálogo» o el filtro «Todas»." Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
      </Grid>
    </DockPanel>

    <!-- Pasos y notas -->
    <Border Grid.Column="1" Width="380" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0"
            Visibility="{Binding HasGuide, Converter={StaticResource Visible}}" core:Ui.Entrance="True">
      <DockPanel Margin="24,28,24,20" DataContext="{Binding Guide}">
        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" core:Ui.Icon="&#xE711;" VerticalAlignment="Top" ToolTip="Cerrar" AutomationProperties.Name="Cerrar pasos y notas"
                  Command="{Binding DataContext.CloseGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Pasos y notas" Style="{StaticResource Overline}" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,6,0,16"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <TextBlock Text="Tus notas" Style="{StaticResource Overline}"/>
          <TextBox Text="{Binding UserNote, UpdateSourceTrigger=PropertyChanged}" Tag="Escribe aquí lo que quieras recordar…" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="76" MaxHeight="160" Margin="0,6,0,12" AutomationProperties.Name="Tus notas"/>
          <WrapPanel>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE73E;" Content="Comprobar" Margin="0,0,8,0" Command="{Binding DataContext.CheckGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Button Style="{StaticResource Ghost}" core:Ui.Icon="&#xE8A7;" Content="{Binding LinkLabel}" Visibility="{Binding HasLink, Converter={StaticResource Visible}}"
                    Command="{Binding DataContext.OpenGuideLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          </WrapPanel>
          <TextBlock Text="{Binding Technical}" Foreground="{StaticResource Attention}" Margin="0,10,0,0" Visibility="{Binding Technical, Converter={x:Static core:TextToVisibility.Instance}}"/>
          <TextBlock Text="Los pasos y la nota se guardan al cerrar. La comprobación técnica no confirma cuentas, licencias ni pruebas físicas: esas las marcas tú." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ListRow}" Padding="0,10">
                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="19"/>
                    </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Informe al terminar -->
    <Border Grid.ColumnSpan="2" Background="{StaticResource Scrim}" Visibility="{Binding HasReport, Converter={StaticResource Visible}}" core:Ui.Entrance="True">
      <Border Background="{StaticResource SurfaceOverlay}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusOverlay}"
              MaxWidth="760" Margin="48" Padding="28,24" DataContext="{Binding Report}" Effect="{StaticResource OverlayShadow}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Border Style="{StaticResource IconTile}" DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE9F9;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel>
              <TextBlock Text="Informe de la instalación" Style="{StaticResource SectionTitle}" FontSize="20"/>
              <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Ghost}" core:Ui.Icon="&#xE8C8;" Content="Copiar informe" Margin="0,0,8,0" Command="{Binding DataContext.CopyReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE72C;" Content="Reintentar fallidas" Margin="0,0,8,0" Command="{Binding DataContext.RetryReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Button Style="{StaticResource Primary}" Content="Cerrar" MinWidth="110" IsCancel="True" Command="{Binding DataContext.CloseReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          </WrapPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ListRow}">
                    <StackPanel>
                      <WrapPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource AttentionSoft}">
                          <TextBlock Text="{Binding KindText}" Style="{StaticResource PillText}" Foreground="{StaticResource Attention}"/>
                        </Border>
                      </WrapPanel>
                      <TextBlock Text="{Binding Reason}" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                      <TextBlock Text="{Binding Code}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0" Visibility="{Binding HasCode, Converter={StaticResource Visible}}"/>
                      <TextBlock Text="{Binding Action}" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/>
                      <Border Style="{StaticResource CardInset}" Margin="0,8,0,0" Padding="10,8" Visibility="{Binding HasLines, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Lines}" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
