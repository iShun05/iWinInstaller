<UserControl x:Class="IWinInstaller.App.Modules.Maintenance.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18,16"/><Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,28,32,24" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="Mantenimiento y salud" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
      <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Salud del equipo" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding Health}" Foreground="{StaticResource TextMuted}"/>
          <WrapPanel Margin="0,12,0,0">
            <Button Style="{StaticResource Btn}" Content="Informe de la batería" Command="{Binding BatteryReportCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" Content="Exportar informe del equipo…" Command="{Binding ReportCommand}" Margin="0,0,8,8"/>
            <CheckBox Content="Incluir números de serie, nombre del equipo y usuario" IsChecked="{Binding IncludeSensitive}" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="4,0,0,8"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel LastChildFill="False">
            <TextBlock Text="Liberar espacio" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Volver a calcular" Command="{Binding EstimateCommand}"/>
          </DockPanel>
          <TextBlock Text="{Binding Total}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,10"/>
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,4">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" Foreground="{StaticResource Ok}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding EstimatedText}" Foreground="{StaticResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Primary}" Content="Liberar espacio" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding CleanCommand}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Reparar Windows" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
          <TextBlock Text="DISM repara la imagen de Windows y SFC comprueba los archivos del sistema. Útil si Windows Update falla o aparecen errores raros. Pide permiso de administrador."
                     Foreground="{StaticResource TextMuted}" Margin="0,6,0,10"/>
          <Button Style="{StaticResource Btn}" Content="Reparar Windows" HorizontalAlignment="Left" Command="{Binding RepairCommand}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
