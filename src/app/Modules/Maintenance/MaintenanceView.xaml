<UserControl x:Class="IWinInstaller.App.Modules.Maintenance.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Left">
      <DockPanel LastChildFill="False" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Mantenimiento y salud" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="Estado del equipo, espacio en disco, carpetas del menú Inicio y reparación de Windows."/>
        </StackPanel>
      </DockPanel>
      <ContentControl Style="{StaticResource InfoBar}" Content="{Binding Message}"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0" VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE95E;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Salud del equipo" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="{Binding Health}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
          <WrapPanel>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE945;" Content="Informe de la batería" Command="{Binding BatteryReportCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE72D;" Content="Exportar informe del equipo…" Command="{Binding ReportCommand}" Margin="0,0,8,8"/>
            <CheckBox Content="Incluir números de serie, nombre del equipo y usuario" IsChecked="{Binding IncludeSensitive}" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="8,0,0,8"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" core:Ui.Icon="&#xE72C;" Content="Volver a calcular" Command="{Binding EstimateCommand}" VerticalAlignment="Top"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Liberar espacio" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{Binding Total}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ListRow}" Padding="0,8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" Foreground="{StaticResource Ok}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding EstimatedText}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Primary}" core:Ui.Icon="&#xE74D;" Content="Liberar espacio" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding CleanCommand}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0" VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Carpetas por categoría" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="Ordena por categoría las apps de Inicio, del usuario y de todos los usuarios, aunque no las instalara iWinInstaller." Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Windows 11 no permite carpetas ancladas: se crean subcarpetas en «Todas las apps» y una carpeta «Aplicaciones» en el escritorio. Para verlas, en Inicio › Todo elige «Visualización» Lista o Cuadrícula. Windows muestra suelta una carpeta con una sola app y siempre sueltas las apps de la Tienda (estas sí van ordenadas en el escritorio). Si una actualización recrea un acceso, vuelve a pulsar el botón."
                     Style="{StaticResource Caption}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding FoldersInfo}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
          <CheckBox Content="Menú Inicio (subcarpetas en «Todas las apps»)" IsChecked="{Binding FoldersStartMenu}" Foreground="{StaticResource Text}" Margin="0,3"/>
          <CheckBox Content="Carpeta en el escritorio" IsChecked="{Binding FoldersDesktop}" Foreground="{StaticResource Text}" Margin="0,3"/>
          <CheckBox Content="Incluir las apps que no instaló iWinInstaller" IsChecked="{Binding FoldersOthers}" Foreground="{StaticResource Text}" Margin="0,3"/>
          <CheckBox Content="Guardar aparte desinstaladores, ayudas y webs" IsChecked="{Binding FoldersExtras}" Foreground="{StaticResource Text}" Margin="0,3"/>
          <CheckBox Content="Ordenar automáticamente al terminar de instalar" IsChecked="{Binding FoldersAuto}" Foreground="{StaticResource Text}" Margin="0,3,0,12"/>
          <WrapPanel>
            <Button Style="{StaticResource Primary}" core:Ui.Icon="&#xE73E;" Content="Comprobar y organizar" Command="{Binding OrganizeCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE7A7;" Content="Deshacer" Command="{Binding UndoFoldersCommand}"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0" VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE90F;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Reparar Windows" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="DISM repara la imagen de Windows y SFC comprueba los archivos del sistema. Útil si Windows Update falla o aparecen errores raros. Pide permiso de administrador." Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
          <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE90F;" Content="Reparar Windows" HorizontalAlignment="Left" Command="{Binding RepairCommand}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
