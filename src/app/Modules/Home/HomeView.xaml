<UserControl x:Class="IWinInstaller.App.Modules.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <DataTemplate x:Key="StatusCardTemplate" DataType="{x:Type core:StatusCard}">
      <Border x:Name="card" Style="{StaticResource Card}" MinHeight="152" Margin="0,0,12,12" Padding="18,16,18,14"
              Visibility="{Binding IsVisible, Converter={StaticResource Visible}}"
              AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Summary}">
        <DockPanel LastChildFill="True">
          <!-- Cabecera: icono del área, título y pastilla de estado -->
          <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,14">
            <Border x:Name="pill" DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="8,0,0,0" ToolTip="{Binding StateLabel}" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="dot" Style="{StaticResource StatusGlyph}"/>
                <TextBlock x:Name="state" Style="{StaticResource PillText}" Text="{Binding StateLabel}" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <Border x:Name="iconBox" Style="{StaticResource IconTile}" Background="{StaticResource SurfaceRaised}" Margin="0,0,10,0">
              <TextBlock x:Name="icon" Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </DockPanel>
          <!-- Acción al pie, solo si existe -->
          <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="Abrir" HorizontalAlignment="Left" Margin="0,10,0,0"
                  Command="{Binding DataContext.OpenActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}" Visibility="{Binding HasAction, Converter={StaticResource Visible}}"
                  AutomationProperties.Name="{Binding Title, StringFormat=Abrir {0}}"/>
          <StackPanel>
            <TextBlock Text="{Binding Summary}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" LineHeight="24"/>
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Reason}" Margin="0,4,0,0"
                       Visibility="{Binding HasReason, Converter={StaticResource Visible}}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Ok">
          
          <Setter TargetName="dot" Property="Foreground" Value="{StaticResource Ok}"/><Setter TargetName="dot" Property="Text" Value="&#xE930;"/>
          
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Attention">
          
          <Setter TargetName="dot" Property="Foreground" Value="{StaticResource Attention}"/><Setter TargetName="dot" Property="Text" Value="&#xE7BA;"/>
          
          <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AttentionBorder}"/>
          <Setter TargetName="iconBox" Property="Background" Value="{StaticResource AttentionSoft}"/>
          <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Attention}"/>
        </DataTrigger>
        <Trigger SourceName="card" Property="IsMouseOver" Value="True">
          <Setter TargetName="card" Property="Background" Value="{StaticResource SurfaceHover}"/>
          <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Left">
      <DockPanel Margin="0,0,0,24" LastChildFill="False">
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Top" Content="Comprobar de nuevo"
                core:Ui.Icon="&#xE72C;" Command="{Binding Home.RefreshCommand}" ToolTip="Comprobar de nuevo (F5)"/>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Estado del PC"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0" Text="{Binding Home.Headline}"/>
            <TextBlock Style="{StaticResource Caption}" Text="  ·  " VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding Home.LastChecked}" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
      <!-- Rejilla que se adapta al ancho: de 1 a 4 columnas con tarjetas del mismo tamaño -->
      <ItemsControl ItemsSource="{Binding Home.Cards}" ItemTemplate="{StaticResource StatusCardTemplate}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={x:Static core:WidthToColumns.Instance}}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <!-- Las tarjetas que no aplican (p. ej. batería en un sobremesa) no ocupan hueco -->
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Visible}}"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
