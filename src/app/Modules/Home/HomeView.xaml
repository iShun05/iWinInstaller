<UserControl x:Class="IWinInstaller.App.Modules.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <DataTemplate x:Key="Card" DataType="{x:Type core:StatusCard}">
      <Border x:Name="card" Width="300" MinHeight="132" Margin="0,0,14,14" Padding="18,16" CornerRadius="14"
              Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
              Visibility="{Binding IsVisible, Converter={StaticResource Visible}}"
              AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Summary}">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Ellipse x:Name="dot" Width="9" Height="9" Fill="{StaticResource Unknown}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontSize="15" Margin="0,0,0,4"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Reason}" Foreground="{StaticResource TextMuted}"
                     Visibility="{Binding HasReason, Converter={StaticResource Visible}}"/>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="state" Text="{Binding StateText}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Abrir"
                    Command="{Binding DataContext.OpenActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" Visibility="{Binding HasAction, Converter={StaticResource Visible}}"
                    AutomationProperties.Name="{Binding Title, StringFormat=Abrir {0}}"/>
          </DockPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Ok"><Setter TargetName="dot" Property="Fill" Value="{StaticResource Ok}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Attention">
          <Setter TargetName="dot" Property="Fill" Value="{StaticResource Attention}"/>
          <Setter TargetName="card" Property="BorderBrush" Value="#4A3D24"/>
          <Setter TargetName="state" Property="Foreground" Value="{StaticResource Attention}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,28,18,24">
      <DockPanel Margin="0,0,14,20" LastChildFill="False">
        <StackPanel>
          <TextBlock Text="Estado del PC" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
          <TextBlock Text="{Binding Home.LastChecked}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Comprobar de nuevo" VerticalAlignment="Top"
                Command="{Binding Home.RefreshCommand}"/>
      </DockPanel>
      <ItemsControl ItemsSource="{Binding Home.Cards}" ItemTemplate="{StaticResource Card}" Focusable="False">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
