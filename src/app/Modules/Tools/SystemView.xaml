<UserControl x:Class="IWinInstaller.App.Modules.Tools.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Left">
      <DockPanel LastChildFill="False" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Sistema" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSubtitle}"
                     Text="Pantalla y energía sin abrir Configuración. Los ajustes de Windows del catálogo (tema oscuro, menú clásico, rutas largas…) están en Instalar › Sistema, con Deshacer."/>
        </StackPanel>
      </DockPanel>
      <ContentControl Style="{StaticResource InfoBar}" Content="{Binding Message}"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Resolución y frecuencia" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="{Binding Current}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Monitor" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <ComboBox Grid.Column="1" MinWidth="260" Margin="0,0,0,8" HorizontalAlignment="Left" ItemsSource="{Binding Monitors}" SelectedItem="{Binding Monitor}" AutomationProperties.Name="Monitor"/>
            <TextBlock Grid.Row="1" Text="Resolución" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="170" Margin="0,0,0,8" HorizontalAlignment="Left" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" AutomationProperties.Name="Resolución"/>
            <TextBlock Grid.Row="2" Text="Frecuencia" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="110" Margin="0,0,0,8" HorizontalAlignment="Left" ItemsSource="{Binding Rates}" SelectedItem="{Binding Rate}" AutomationProperties.Name="Frecuencia"/>
          </Grid>
          <Button Style="{StaticResource Primary}" core:Ui.Icon="&#xE73E;" Content="Aplicar" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding ApplyDisplayCommand}"/>
          <Border Background="{StaticResource AttentionSoft}" BorderBrush="{StaticResource AttentionBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="14,10" Margin="0,14,0,0" Visibility="{Binding Confirming, Converter={StaticResource Visible}}">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource Attention}" FontSize="16" Margin="0,0,10,0"/>
              <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" core:Ui.Icon="&#xE73E;" Content="Mantener" Command="{Binding KeepCommand}"/>
              <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" core:Ui.Icon="&#xE7A7;" Content="Volver" Command="{Binding RevertCommand}" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding ConfirmText}" VerticalAlignment="Center" Foreground="{StaticResource Attention}" Margin="0,0,12,0"/>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Energía (corriente y batería)" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="{Binding Plan}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Apagar la pantalla tras" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <ComboBox MinWidth="170" Margin="0,0,0,8" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding MonitorOffChoices}" SelectedItem="{Binding MonitorOff}"/>
            <TextBlock Grid.Row="1" Text="Suspender tras" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <ComboBox MinWidth="170" Margin="0,0,0,8" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding SleepChoices}" SelectedItem="{Binding Sleep}"/>
            <TextBlock Grid.Row="2" Text="Hibernar tras" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <ComboBox MinWidth="170" Margin="0,0,0,8" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding HibernateAfterChoices}" SelectedItem="{Binding HibernateAfter}"/>
            <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Hibernación activada (si la desactivas se libera hiberfil.sys; pide permiso)" IsChecked="{Binding Hibernate}" Foreground="{StaticResource Text}" Margin="0,6,0,8"/>
          </Grid>
          <Button Style="{StaticResource Primary}" core:Ui.Icon="&#xE73E;" Content="Aplicar energía" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding ApplyPowerCommand}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
