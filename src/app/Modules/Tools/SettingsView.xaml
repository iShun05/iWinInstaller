<UserControl x:Class="IWinInstaller.App.Modules.Tools.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Left">
      <DockPanel LastChildFill="False" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Ajustes" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="{Binding Version}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
      </DockPanel>
      <ContentControl Style="{StaticResource InfoBar}" Content="{Binding Message}"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Actualizaciones" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="Mantén iWinInstaller al día sin tocar otras aplicaciones." Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
          <CheckBox Content="Actualizar iWinInstaller automáticamente" IsChecked="{Binding AutoUpdate}" Foreground="{StaticResource TextStrong}" FontWeight="SemiBold"/>
          <TextBlock Text="Desactivada al principio. Al activarla (pide permiso una vez) comprueba GitHub al iniciar sesión y una vez al día, descarga solo la versión estable, verifica SHA256 y sustituye la app cuando la cierras. No actualiza otras aplicaciones."
                     Style="{StaticResource Caption}" Margin="0,6,0,12"/>
          <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE72C;" Content="Buscar nueva versión ahora" HorizontalAlignment="Left" Command="{Binding SelfUpdateCommand}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Diagnóstico y actividad" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="El diagnóstico se guarda en Descargas, empieza por el informe de la última instalación y oculta la ruta del perfil, correos y claves. Revísalo antes de compartirlo."
                         Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
          <WrapPanel>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE72D;" Content="Exportar diagnóstico" Command="{Binding DiagnosticCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Ghost}" core:Ui.Icon="&#xE838;" Content="Abrir la carpeta de registros" Command="{Binding ActivityCommand}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
