<UserControl x:Class="IWinInstaller.App.Modules.Tools.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Left">
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" core:Ui.Icon="&#xEA18;" Content="Abrir Seguridad de Windows" Command="{Binding OpenCommand}" VerticalAlignment="Top" Margin="16,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Seguridad" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
      </DockPanel>
      <ContentControl Style="{StaticResource InfoBar}" Content="{Binding Message}"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Microsoft Defender" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
          <WrapPanel>
            <Button Style="{StaticResource Primary}" core:Ui.Icon="&#xE721;" Content="Análisis rápido" Command="{Binding QuickCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE9D9;" Content="Análisis completo" Command="{Binding FullCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE838;" Content="Analizar una carpeta…" Command="{Binding FolderCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" core:Ui.Icon="&#xE895;" Content="Actualizar firmas" Command="{Binding UpdateCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}" Margin="0,0,12,0" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Amenazas recientes" Style="{StaticResource CardTitle}" Margin="0,6,0,4"/>
            <TextBlock Text="{Binding Threats}" Style="{StaticResource Muted}"/>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Text="No se instala otro antivirus: si quieres uno, Instalar › Antivirus y antimalware." Style="{StaticResource Caption}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
