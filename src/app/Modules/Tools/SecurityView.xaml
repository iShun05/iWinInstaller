<UserControl x:Class="IWinInstaller.App.Modules.Tools.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18,16"/><Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,28,32,24" MaxWidth="860" HorizontalAlignment="Left">
      <DockPanel LastChildFill="False">
        <TextBlock Text="Seguridad" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Abrir Seguridad de Windows" Command="{Binding OpenCommand}"/>
      </DockPanel>
      <TextBlock Text="{Binding Summary}" FontSize="15" Margin="0,10,0,6"/>
      <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Microsoft Defender" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextMuted}"/>
          <WrapPanel Margin="0,14,0,0">
            <Button Style="{StaticResource Primary}" Content="Análisis rápido" Command="{Binding QuickCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" Content="Análisis completo" Command="{Binding FullCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" Content="Analizar una carpeta…" Command="{Binding FolderCommand}" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn}" Content="Actualizar firmas" Command="{Binding UpdateCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Amenazas recientes" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding Threats}" Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
      </Border>
      <TextBlock Text="No se instala otro antivirus: si quieres uno, Instalar › Antivirus y antimalware." Foreground="#77777F" FontSize="12"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
