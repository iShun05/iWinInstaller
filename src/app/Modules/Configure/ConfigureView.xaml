<UserControl x:Class="IWinInstaller.App.Modules.Configure.ConfigureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IWinInstaller.App.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Left">
      <DockPanel LastChildFill="True" Margin="0,0,0,20">
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Top" Content="Comprobar"
                core:Ui.Icon="&#xE72C;" Command="{Binding RefreshCommand}"/>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Por configurar"/>
          <TextBlock Style="{StaticResource PageSubtitle}"
                     Text="Marca cada app cuando termines de configurarla. Si se actualiza a otra versión, el check se quita solo y vuelve a salir pendiente."/>
        </StackPanel>
      </DockPanel>
      <ContentControl Style="{StaticResource InfoBar}" Content="{Binding Message}"/>

      <!-- Leyenda de estados -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Attention}" Margin="0,0,6,0"/>
        <TextBlock Style="{StaticResource Caption}" Text="Instalada, falta configurarla" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Ok}" Margin="0,0,6,0"/>
        <TextBlock Style="{StaticResource Caption}" Text="Configurada" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Danger}" Margin="0,0,6,0"/>
        <TextBlock Style="{StaticResource Caption}" Text="No instalada: se ve en Instalar → Faltan" VerticalAlignment="Center"/>
      </StackPanel>

      <Border Style="{StaticResource Card}" Padding="20,10,20,6" Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource ListRow}">
                <DockPanel LastChildFill="True">
                  <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Initials}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Marcar como hecha" core:Ui.Icon="&#xE73E;" Margin="0,0,0,6" MinWidth="160"
                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                          <Style.Triggers><DataTrigger Binding="{Binding Configured}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Content="Hecha · quitar" core:Ui.Icon="&#xE711;" Margin="0,0,0,6" MinWidth="160"
                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DangerGhost}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers><DataTrigger Binding="{Binding Configured}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Content="Abrir" core:Ui.Icon="&#xE8E5;" Visibility="{Binding CanOpen, Converter={StaticResource Visible}}"
                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                  </StackPanel>
                  <StackPanel>
                    <DockPanel>
                      <Ellipse ToolTip="{Binding Status}" Margin="0,0,8,0">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                            <Setter Property="Fill" Value="{StaticResource Attention}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Configured}" Value="True"><Setter Property="Fill" Value="{StaticResource Ok}"/></DataTrigger></Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Note}" Margin="0,2,0,0"/>
                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Attention}" Text="{Binding Missing}" Margin="0,4,0,0" Visibility="{Binding HasMissing, Converter={StaticResource Visible}}"/>
                    <TextBlock Text="{Binding Status}" Margin="0,4,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{StaticResource Attention}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Configured}" Value="True"><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Estado vacío -->
      <Border Padding="20,36">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers><DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="28" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center"/>
          <TextBlock Style="{StaticResource Muted}" Text="No hay apps pendientes de configurar." Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
