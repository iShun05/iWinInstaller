<UserControl x:Class="IWinInstaller.App.Modules.Configure.ConfigureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,28,32,24" MaxWidth="920" HorizontalAlignment="Left">
      <DockPanel LastChildFill="False" Margin="0,0,0,6">
        <TextBlock Text="Por configurar" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Comprobar" Command="{Binding RefreshCommand}"/>
      </DockPanel>
      <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="Marca cada app cuando termines de configurarla. Si se actualiza a otra versión, el check se quita solo y vuelve a salir pendiente."
                 Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,4,0,16"/>

      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="6"
              Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,10">
                <DockPanel LastChildFill="True">
                  <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Initials}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Marcar como hecha" Margin="0,0,0,6" MinWidth="150"
                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                          <Style.Triggers><DataTrigger Binding="{Binding Configured}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Content="✓ Hecha · quitar" Margin="0,0,0,6" MinWidth="150"
                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers><DataTrigger Binding="{Binding Configured}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Content="Abrir" Visibility="{Binding CanOpen, Converter={StaticResource Visible}}"
                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextStrong}"/>
                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{StaticResource Attention}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Configured}" Value="True"><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
