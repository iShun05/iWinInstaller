<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Paleta negra de iWinInstaller: la misma que la ventana clásica -->
  <SolidColorBrush x:Key="Background" Color="#0F0F13"/>
  <SolidColorBrush x:Key="Surface" Color="#18181B"/>
  <SolidColorBrush x:Key="SurfaceHover" Color="#1F1F24"/>
  <SolidColorBrush x:Key="Border" Color="#2B2B30"/>
  <SolidColorBrush x:Key="Text" Color="#EDEDF2"/>
  <SolidColorBrush x:Key="TextStrong" Color="#F5F5F7"/>
  <SolidColorBrush x:Key="TextMuted" Color="#ADADB5"/>
  <SolidColorBrush x:Key="Accent" Color="#8CC4FF"/>
  <SolidColorBrush x:Key="AccentText" Color="#0B0B0F"/>
  <SolidColorBrush x:Key="Ok" Color="#7BD88F"/>
  <SolidColorBrush x:Key="Attention" Color="#FFC86B"/>
  <SolidColorBrush x:Key="Unknown" Color="#8E8E99"/>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Background" Value="#22222B"/>
    <Setter Property="BorderBrush" Value="#30303A"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#8CC4FF"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{StaticResource Accent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="#C8C8D2"/>
    <Setter Property="Padding" Value="10,5"/>
  </Style>

  <!-- Navegación lateral: una lista con marca de selección a la izquierda -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="12,9" Margin="0,1" BorderThickness="1" BorderBrush="Transparent">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="mark" Background="{StaticResource Accent}" CornerRadius="2" Visibility="Hidden" Margin="-8,2,0,2"/>
              <ContentPresenter Grid.Column="1"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#19191D"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="b" Property="Background" Value="#1C1C22"/>
              <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#8CC4FF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
