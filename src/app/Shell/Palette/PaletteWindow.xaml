<Window x:Class="IWinInstaller.App.Shell.Palette.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Width="668" SizeToContent="Height" WindowStartupLocation="CenterOwner" Topmost="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Title="Buscar en iWinInstaller">
  <Border Background="{StaticResource SurfaceOverlay}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusOverlay}"
          Padding="12" Margin="24,60,24,36" Effect="{StaticResource OverlayShadow}" SnapsToDevicePixels="True">
    <StackPanel>
      <TextBox x:Name="Query" Style="{StaticResource SearchBox}" MinHeight="40" FontSize="15"
               Tag="Buscar una acción o una app…"
               AutomationProperties.Name="Buscar una acción o una app" TextChanged="OnQueryChanged" PreviewKeyDown="OnKey"/>
      <TextBlock Text="Escribe lo que quieres hacer: «resolución», «ssh», «defender», «git»…  ·  Enter abre · Esc cierra" Style="{StaticResource Caption}" Margin="4,10,4,8"/>
      <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" MaxHeight="420" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="OnRun" PreviewKeyDown="OnKey" AutomationProperties.Name="Resultados">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="b" CornerRadius="{StaticResource RadiusControl}" Padding="16,9,12,9" Background="Transparent">
                    <Grid>
                      <Border x:Name="bar" Width="3" Height="16" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0" Opacity="0"/>
                      <ContentPresenter/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="b" Property="Background" Value="{StaticResource SelectedFill}"/>
                      <Setter TargetName="bar" Property="Opacity" Value="1"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Module}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="NoWrap"/>
              <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </Border>
</Window>
