<Window x:Class="IWinInstaller.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:home="clr-namespace:IWinInstaller.App.Modules.Home"
        xmlns:updates="clr-namespace:IWinInstaller.App.Modules.Updates"
        xmlns:install="clr-namespace:IWinInstaller.App.Modules.Install"
        xmlns:tools="clr-namespace:IWinInstaller.App.Modules.Tools"
        xmlns:core="clr-namespace:IWinInstaller.App.Core"
        Title="iWinInstaller" Width="1180" Height="780" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Background}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding ZoomResetCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="NumPad0" Command="{Binding ZoomResetCommand}"/>
    <KeyBinding Key="F5" Command="{Binding Home.RefreshCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding OpenPaletteCommand}"/>
  </Window.InputBindings>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </Window.Resources>
  <Grid x:Name="Root">
    <Grid.LayoutTransform>
      <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
    </Grid.LayoutTransform>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navegación lateral -->
    <Border Background="#0B0B0F" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,22,14,16">
        <TextBlock DockPanel.Dock="Top" Text="iWinInstaller" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="10,0,0,14"/>
        <Button DockPanel.Dock="Top" Style="{StaticResource Btn}" HorizontalContentAlignment="Left" Margin="0,0,0,14" Command="{Binding OpenPaletteCommand}" ToolTip="Busca cualquier acción o app (Ctrl + K)" AutomationProperties.Name="Buscar (Ctrl + K)">
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl K" Foreground="#77777F" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/><TextBlock Text="Buscar…" Foreground="{StaticResource TextMuted}"/></DockPanel>
        </Button>
        <StackPanel DockPanel.Dock="Bottom" Margin="6,12,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource Ghost}" Content="A−" Command="{Binding ZoomOutCommand}" ToolTip="Reducir (Ctrl −)" AutomationProperties.Name="Reducir tamaño"/>
            <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="4,0"/>
            <Button Style="{StaticResource Ghost}" Content="A+" Command="{Binding ZoomInCommand}" ToolTip="Ampliar (Ctrl +)" AutomationProperties.Name="Ampliar tamaño"/>
          </StackPanel>
          <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
          <TextBlock Margin="0,4,0,0" FontSize="12">
            <Hyperlink Command="{Binding OpenInstagramCommand}" Foreground="{StaticResource Accent}" TextDecorations="{x:Null}">Instagram @_shun._05</Hyperlink>
          </TextBlock>
        </StackPanel>
        <ListBox x:Name="Navigation" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Secciones">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Text="ventana clásica" FontSize="11" Foreground="#77777F" Visibility="{Binding IsClassic, Converter={StaticResource Visible}}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Contenido -->
    <Grid Grid.Column="1">
      <home:HomeView Visibility="{Binding IsHome, Converter={StaticResource Visible}}"/>
      <install:InstallView DataContext="{Binding Install}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=install}"/>
      <tools:SystemView DataContext="{Binding SystemPage}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=system}"/>
      <tools:SecurityView DataContext="{Binding Security}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=security}"/>
      <tools:LinkView DataContext="{Binding Link}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=remote}"/>
      <tools:SettingsView DataContext="{Binding Settings}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=settings}"/>
      <updates:UpdatesView Visibility="{Binding PageId, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=updates}"/>
      <StackPanel Visibility="{Binding IsClassicPage, Converter={StaticResource Visible}}" Margin="32,28,32,24" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Selected.Title}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
        <TextBlock Text="{Binding Selected.Description}" Foreground="{StaticResource TextMuted}" Margin="0,6,0,18"/>
        <TextBlock Margin="0,0,0,16">Esta sección todavía se abre en la ventana clásica, con todas sus funciones. Pasará a esta ventana en las próximas versiones.</TextBlock>
        <Button Style="{StaticResource Primary}" Content="Abrir en la ventana clásica" HorizontalAlignment="Left" Command="{Binding OpenClassicCommand}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
