<Window x:Class="IWinInstaller.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:home="clr-namespace:IWinInstaller.App.Modules.Home"
        xmlns:configure="clr-namespace:IWinInstaller.App.Modules.Configure"
        xmlns:updates="clr-namespace:IWinInstaller.App.Modules.Updates"
        xmlns:install="clr-namespace:IWinInstaller.App.Modules.Install"
        xmlns:tools="clr-namespace:IWinInstaller.App.Modules.Tools"
        xmlns:maintenance="clr-namespace:IWinInstaller.App.Modules.Maintenance"
        xmlns:gaming="clr-namespace:IWinInstaller.App.Modules.Gaming"
        xmlns:games="clr-namespace:IWinInstaller.App.Modules.Games"
        xmlns:equipo="clr-namespace:IWinInstaller.App.Modules.Equipo"
        xmlns:rendimiento="clr-namespace:IWinInstaller.App.Modules.Rendimiento"
        xmlns:core="clr-namespace:IWinInstaller.App.Core"
        Title="iWinInstaller" Width="1180" Height="780" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Background}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding ZoomResetCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="NumPad0" Command="{Binding ZoomResetCommand}"/>
    <KeyBinding Key="F5" Command="{Binding Home.RefreshCommand}"/>
    <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding OpenPaletteCommand}"/>
  </Window.InputBindings>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <!-- Secciones agrupadas (v5.7): el orden de los grupos es el de su primera sección -->
    <CollectionViewSource x:Key="NavGroups" Source="{Binding Items}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Group"/>
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </Window.Resources>
  <Grid x:Name="Root">
    <Grid.LayoutTransform>
      <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
    </Grid.LayoutTransform>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navegación lateral -->
    <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,18,12,14">
        <!-- Marca -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,16">
          <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" Margin="0,0,10,0">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="iWinInstaller" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="NoWrap"/>
            <TextBlock Text="Centro de control" Style="{StaticResource Caption}" FontSize="11" TextWrapping="NoWrap"/>
          </StackPanel>
        </StackPanel>
        <!-- Búsqueda global -->
        <Button DockPanel.Dock="Top" Style="{StaticResource Btn}" Background="{StaticResource SurfaceInput}" BorderBrush="{StaticResource Border}" HorizontalContentAlignment="Stretch" Padding="10,0" Margin="0,0,0,14"
                core:Ui.Icon="&#xE721;" Foreground="{StaticResource TextMuted}"
                Command="{Binding OpenPaletteCommand}" ToolTip="Busca cualquier acción o app (Ctrl + K)" AutomationProperties.Name="Buscar (Ctrl + K)">
          <DockPanel>
            <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="5,0,5,1" VerticalAlignment="Center">
              <TextBlock Text="Ctrl K" Foreground="{StaticResource TextFaint}" FontSize="10.5"/>
            </Border>
            <TextBlock Text="Buscar" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
          </DockPanel>
        </Button>
        <!-- Pie: tamaño, versión e Instagram -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="8,12,4,0" Margin="0,10,0,0">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Tamaño" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Width="28" Height="28" core:Ui.Icon="&#xE738;" Command="{Binding ZoomOutCommand}" ToolTip="Reducir (Ctrl −)" AutomationProperties.Name="Reducir tamaño"/>
                <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12" MinWidth="42" TextAlignment="Center"/>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28" core:Ui.Icon="&#xE710;" Command="{Binding ZoomInCommand}" ToolTip="Ampliar (Ctrl +)" AutomationProperties.Name="Ampliar tamaño"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}"/>
            <TextBlock Margin="0,2,0,0" FontSize="12">
              <Hyperlink Command="{Binding OpenInstagramCommand}">Instagram @_shun._05</Hyperlink>
            </TextBlock>
          </StackPanel>
        </Border>
        <ListBox x:Name="Navigation" ItemsSource="{Binding Source={StaticResource NavGroups}}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Secciones">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock x:Name="header" Text="{Binding Name}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="12,10,0,4"/>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Name}" Value=""><Setter TargetName="header" Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="900">
                <TextBlock x:Name="glyph" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="16" Width="18" Margin="0,0,12,0"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center" TextWrapping="NoWrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Contenido -->
    <Grid Grid.Column="1">
      <home:HomeView core:Ui.Entrance="True" Visibility="{Binding IsHome, Converter={StaticResource Visible}}"/>
      <install:InstallView core:Ui.Entrance="True" DataContext="{Binding Install}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=install}"/>
      <tools:SystemView core:Ui.Entrance="True" DataContext="{Binding SystemPage}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=system}"/>
      <equipo:EquipoView core:Ui.Entrance="True" DataContext="{Binding Equipo}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=equipo}"/>
      <rendimiento:PerformanceView core:Ui.Entrance="True" DataContext="{Binding Performance}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=performance}"/>
      <games:GamesView core:Ui.Entrance="True" DataContext="{Binding Games}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=games}"/>
      <gaming:GamingView core:Ui.Entrance="True" DataContext="{Binding Gaming}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=gaming}"/>
      <tools:SecurityView core:Ui.Entrance="True" DataContext="{Binding Security}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=security}"/>
      <tools:LinkView core:Ui.Entrance="True" DataContext="{Binding Link}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=remote}"/>
      <tools:SettingsView core:Ui.Entrance="True" DataContext="{Binding Settings}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=settings}"/>
      <maintenance:MaintenanceView core:Ui.Entrance="True" DataContext="{Binding Maintenance}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=maintenance}"/>
      <configure:ConfigureView core:Ui.Entrance="True" DataContext="{Binding Configure}" Visibility="{Binding DataContext.PageId, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=configure}"/>
      <updates:UpdatesView core:Ui.Entrance="True" Visibility="{Binding PageId, Converter={x:Static core:EqualsToVisibility.Instance}, ConverterParameter=updates}"/>
    </Grid>
  </Grid>
</Window>
